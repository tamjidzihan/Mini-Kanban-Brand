{
  "name": "taskgrid-backend",
  "version": "1.0.0",
  "description": "Backend API for Taskgrid",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "migration:generate": "sequelize-cli migration:generate"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
